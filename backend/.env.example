# Copy this file to ".env" and fill in your own values
PORT=5000
# Get your key from https://resend.com/api-keys  (starts with re_)

# Free Resend accounts (no verified domain) must send FROM onboarding@resend.dev
# and can only send TO the email you registered Resend with.
EMAIL_FROM=DEV@Deakin <onboarding@resend.dev>
